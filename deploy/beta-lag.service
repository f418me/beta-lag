[Unit]
Description=Beta-lag forward-only market research
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=beta-lag
Group=beta-lag
WorkingDirectory=/opt/beta-lag
EnvironmentFile=/opt/beta-lag/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/beta-lag/.venv/bin/beta-lag live --seconds 0 --output /var/lib/beta-lag --config /opt/beta-lag/config.example.toml
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=60
StateDirectory=beta-lag
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beta-lag

[Install]
WantedBy=multi-user.target

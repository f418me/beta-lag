# API credentials for provider checks and forward-only live collection.
# Copy this file to .env and fill in your own values.
# The current demo and replay commands do not use these credentials.

# Alpaca: generate paper-account API credentials in the dashboard.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# CoinGlass: API key, not your account password.
# Used for current OI snapshots; no historical requests are made.
COINGLASS_API_KEY=

# Hyperliquid and Binance public market data require no API key or wallet.

# Optional: Slack Incoming Webhook for the notification channel. Keep this URL secret.
# Empty disables notifications. Live runs send startup, setup, signal, and paper-trade updates.
SLACK_WEBHOOK_URL=
